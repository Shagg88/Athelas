#include <winver.h>
#include "version_rc.h"   /* written by build.sh from the VERSION file */
1 ICON "../art/rotkfix.ico"
1 VERSIONINFO
FILEVERSION VERSION_RC
PRODUCTVERSION VERSION_RC
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Athelas - launcher for ROTK Fix and the Xbox ports (unofficial fan project)"
      VALUE "ProductName", "Athelas"
      VALUE "FileVersion", VERSION_STR
      VALUE "ProductVersion", VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
1 24 "launcher.manifest"
