+XPP_Current           = 0x0     # XGetDevices 0x1698AA returns it (= 5849)
+XPP_Changed           = 0x4     # XGetDevices 0x1698AC clears it (= 5849)
+XPP_Previous          = 0x8     # XGetDevices 0x1698B2 copies Current into it (= 5849)
