+# XDK 4831 library data layouts the runtime reads or writes, for The Fellowship of the Ring (title 56550004, D3D8LTCG).
+# Checked 2026-10-20 against its code: Textures 0xB38 / Push 0 / PushThreshold 4 / Time 0x30 (SetTexture 0x18ECE0), IndexBuffer 0x38C /
+# BaseVertex 0x1C (SetIndices 0x18EE90), Transforms 0x810 (SetTransform 0x18EA60), RenderTarget 0x21B4 / BackBuffer 0x21C0 / FrontBuffer 0x21C4 / BackBufferScale 0x528 (CommonSetRenderTarget 0x193AF0), SwapCount 0x2C10 (Swap 0x191DD0), Size 0xB0C dwords (CreateDevice 0x1941C0), PixelShader 0x370 (0x192440), VertexShader 0x380 (0x18FB80), Viewport 0xA90 / SuperSample 0x518 / ScreenSpaceOffset 0xAA8 (GetViewportOffsetAndScale 0x193630): all as 4928. The remaining keys are 4928s, unchecked (the proofs quoted below are Two Towers addresses).
+[layout]
+# D3D8 CDevice, the static device D3D__pDevice (0x124180) points at (0x124930, Direct3D_CreateDevice 0x119789)
+CDevice_Push          = 0x0     # D3DDevice_SetTexture 0x117B22 reads it, compares with +4, calls MakeSpace 0x11ABA0 (= 5849)
+CDevice_PushThreshold = 0x4     # D3DDevice_SetTexture 0x117B25 compares the push pointer with it (= 5849)
+CDevice_BaseVertex    = 0x1C    # D3DDevice_SetIndices 0x117CD9 stores BaseVertexIndex (= 5849)
+CDevice_IndexBuffer   = 0x38C   # D3DDevice_SetIndices 0x117CAA reads the old one, 0x117CD2 stores the new one
+CDevice_ZScale        = 0x510   # D3DDevice_GetViewportOffsetAndScale 0x114C45 scales the Z range by it
+CDevice_SuperSampleX  = 0x518   # D3DDevice_GetViewportOffsetAndScale 0x114B9E scales viewport X by it
+CDevice_SuperSampleY  = 0x51C   # D3DDevice_GetViewportOffsetAndScale 0x114BC0 scales viewport Y by it
+CDevice_Transforms    = 0x810   # D3DDevice_SetTransform 0x117246 copies 16 dwords to +0x810 + type * 64
+CDevice_Textures      = 0xB38   # D3DDevice_SetTexture 0x117AE0 reads, 0x117B19 stores [stage]
+CDevice_Palettes      = 0xB48   # the device teardown 0x11D484 walks +0xB48 per stage and releases [-0x10] (textures) and the palette; Textures + 0x10 as in 5849
+CDevice_RenderTarget  = 0x21B4  # D3D_CommonSetRenderTarget 0x115CC2 stores it, D3DDevice_SetViewport 0x11797A compares it with the back buffer
+CDevice_Depth         = 0x21B8  # D3D_CommonSetRenderTarget 0x115CEB stores it
+CDevice_BackBuffer    = 0x21C0  # D3DDevice_GetBackBuffer2 0x1175D0 returns it for index 0
+CDevice_FrontBuffer   = 0x21C4  # D3DDevice_GetBackBuffer2 0x1175B5 returns it for index -1
+CDevice_SwapCount     = 0x2C10  # D3DDevice_Swap 0x11A2E0 increments it, 0x11A351 returns it
+CDevice_Size          = 0x2C30  # Direct3D_CreateDevice 0x1197CB clears 0xB0C dwords of the device on failure
+CDevice_Flags             = 0x8    # Direct3D_CreateDevice 0x11977F ors BehaviorFlags & 0x10 into it (0x124938) (= 5849)
+CDevice_Time              = 0x30   # D3D_KickOffAndWaitForIdle 0x11ABF5 passes it to D3D_BlockOnTime, D3D_SetFence 0x11A8C3 adds 2
+CDevice_PixelShader       = 0x370  # D3DDevice_SetPixelShader 0x119278 stores the handle
+CDevice_VertexShader      = 0x380  # D3DDevice_SetVertexShader 0x117031 reads, 0x117088 stores the current shader (FVF shader object 0x124800)
+CDevice_BackBufferScale   = 0x528  # the frame buffer init 0x11CA1A stores the X scale as a float, 0x11CA33 the Y scale at +4 (SuperSampleX + 0x10 as in 5849)
+CDevice_Viewport          = 0xA90  # D3DDevice_GetViewportOffsetAndScale 0x114B85..0x114C4F reads X, Y, Width, Height, MinZ, MaxZ at +0..+0x14
+CDevice_ScreenSpaceOffset = 0xAA8  # D3DDevice_SetScreenSpaceOffset 0x1180D3 stores x + 0.53125, 0x1180E3 y + 0.53125 at +4
+CDevice_AutoDepth         = 0x21CC # the frame buffer init 0x11CAD9 stores the depth buffer (BackBuffer + 0xC as in 5849)
