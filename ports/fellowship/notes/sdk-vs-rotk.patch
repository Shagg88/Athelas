+CDevice_DisplayFlags      = 0x2574 # miniport + 0x1B4: the mode set 0x11D82A stores it, 0x11996B tests 0x1000000
+CDevice_VBlankCount       = 0x2580 # miniport + 0x1C0: the vertical blank handler 0x11DAA4..0x11DAB1 increments it, 0x1199E7 reads it
+CDevice_Field             = 0x2590 # miniport + 0x1D0: the vertical blank handler 0x11DB14/0x11DB23 stores the field
+CDevice_GammaRamps        = 0x259C # D3DDevice_SetGammaRamp 0x1171F3 copies to miniport + 0x1DC + index * 0x300
+CDevice_GammaPending      = 0x2B9C # D3DDevice_SetGammaRamp 0x117211 sets [miniport + 0x7DC + index * 4]
