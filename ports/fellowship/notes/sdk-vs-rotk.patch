+EffectsImage_Skip1    = 0x80C   # 0x12BFAD loads this dword count (= 5849)
+EffectsImage_Desc     = 0x818   # 0x12BFBC: descriptor at image + 0x818 + (Skip0 + Skip1) * 4 (= 5849)
