index 0000000..a2ace18
--- /dev/null
+++ b/rotkxbox/sdk/xdk/5558/layout.toml
@@ -0,0 +1,57 @@
+# XDK 5558 library data layouts the runtime reads or writes. Each value is proven by the
+# The Return of the King (title 4541003E) default.xbe code at the address given. Derived 2026-10-13.
+# Same keys as xdk/5849/layout.toml. 5558 sits close to 5849: most CDevice fields are 4 to 0x10 lower.
+[layout]
+# D3D8 CDevice, the static device D3D__pDevice (0x13A8C8) points at (0x13A8D0, Direct3D_CreateDevice 0x12F8D9)
+CDevice_Push          = 0x0     # D3DDevice_SetTexture 0x12D682 reads it, compares with +4, calls MakeSpace 0x130210 (= 5849)
+CDevice_PushThreshold = 0x4     # D3DDevice_SetTexture 0x12D685 compares the push pointer with it (= 5849)
+CDevice_BaseVertex    = 0x1C    # D3DDevice_SetIndices 0x12D8C9 stores BaseVertexIndex (= 5849)
+CDevice_IndexBuffer   = 0x79C   # D3DDevice_SetIndices 0x12D89A reads the old one, 0x12D8C2 stores the new one (5849: 0x7A0)
+CDevice_ZScale        = 0x944   # D3DDevice_GetViewportOffsetAndScale 0x12A814 scales the Z range by it (5849: 0x948)
+CDevice_SuperSampleX  = 0x958   # D3DDevice_GetViewportOffsetAndScale 0x12A76E scales viewport X by it (5849: 0x95C)
+CDevice_SuperSampleY  = 0x95C   # D3DDevice_GetViewportOffsetAndScale 0x12A790 scales viewport Y by it (5849: 0x960)
+CDevice_Transforms    = 0xC50   # D3DDevice_SetTransform 0x12CC76 copies 16 dwords to +0xC50 + type * 64 (5849: 0xC60)
+CDevice_Textures      = 0xF78   # D3DDevice_SetTexture 0x12D640 reads, 0x12D679 stores [stage] (5849: 0xF88)
+CDevice_Palettes      = 0xF88   # Textures + 0x10 as in 5849 and 4928 (the game sets palettes through D3DDevice_SetPalette 0x12D7E0)
+CDevice_RenderTarget  = 0x19F4  # D3DDevice_SetViewport 0x12D417 reads it and compares it with the back buffer (5849: 0x1A04)
+CDevice_Depth         = 0x19F8  # D3DDevice_GetDepthStencilSurface2 0x12D3E6 returns it (5849: 0x1A08)
+CDevice_BackBuffer    = 0x1A04  # D3DDevice_GetBackBuffer2 0x12D3C0 returns it for index 0 (5849: 0x1A14)
+CDevice_FrontBuffer   = 0x1A08  # D3DDevice_GetBackBuffer2 0x12D3A5 returns it for index -1 (5849: 0x1A18)
+CDevice_SwapCount     = 0x2468  # D3DDevice_Swap 0x12F730 increments it, 0x12F7AB reads it (5849: 0x2478)
+CDevice_Size          = 0x2490  # Direct3D_CreateDevice 0x12F91B clears 0x924 dwords of the device on failure (5849: 0x24A0)
+CDevice_Flags             = 0x8    # Direct3D_CreateDevice 0x12F8DE ors BehaviorFlags into it and stores it at 0x13A8D8 = device + 8 (= 5849)
+CDevice_Time              = 0x2C   # D3D_KickOffAndWaitForIdle 0x130275 reads it, D3D_SetFence 0x12FEC4 (= 5849)
+CDevice_PixelShader       = 0x780  # D3DDevice_SetPixelShader 0x1304E8 stores the handle (5849: 0x784)
+CDevice_VertexShader      = 0x790  # D3DDevice_SetVertexShader 0x12CA71 reads the current shader (5849: 0x794)
+CDevice_BackBufferScale   = 0x968  # the frame buffer init 0x131ECB stores the X scale as a float, 0x131EE4 the Y scale at +4 (SuperSampleX + 0x10 as in 5849)
+CDevice_Viewport          = 0xED0  # D3DDevice_GetViewportOffsetAndScale 0x12A755..0x12A81E reads X, Y, Width, Height, MinZ, MaxZ at +0..+0x14 (5849: 0xEE0)
+CDevice_ScreenSpaceOffset = 0xEE8  # D3DDevice_SetScreenSpaceOffset 0x12DD73 stores x + 0.53125, 0x12DD83 y + 0.53125 at +4 (5849: 0xEF8)
+CDevice_AutoDepth         = 0x1A10 # the frame buffer init 0x131FCA stores the depth buffer, D3D_InitDefaultState 0x131C57 reads it (BackBuffer + 0xC as in 5849)
+# the miniport is at +0x1C18 (D3DDevice_SetGammaRamp 0x12CBE3; 5849: +0x1C28); its own field offsets are unchanged from 5849
+CDevice_VBlankCallback    = 0x1DA8 # D3DDevice_SetVerticalBlankCallback 0x12CE1A stores it = miniport + 0x190
+CDevice_VBlankEvent       = 0x1DAC # D3DDevice_BlockUntilVerticalBlank 0x12CE47 waits on it, 0x12CE3B clears its SignalState
+CDevice_DisplayFlags      = 0x1DCC # miniport + 0x1B4: 0x12ED7B tests 0x1000000, D3DDevice_GetDisplayFieldStatus 0x12D942 tests 0x1200000
+CDevice_VBlankCount       = 0x1DD8 # miniport + 0x1C0: 0x12EDF7..0x12EE0B increments it, D3DDevice_GetDisplayFieldStatus 0x12D935 reads it
+CDevice_Field             = 0x1DE8 # miniport + 0x1D0: D3DDevice_GetDisplayFieldStatus 0x12D94F reads the field
+CDevice_GammaRamps        = 0x1DF4 # D3DDevice_SetGammaRamp 0x12CC00 copies to miniport + 0x1DC + index * 0x300
+CDevice_GammaPending      = 0x23F4 # D3DDevice_SetGammaRamp 0x12CC41 sets [miniport + 0x7DC + index * 4]
+# D3D8 globals
+DirtyFlags_Texture    = 0x4800  # D3DDevice_SetTexture 0x12D6B7 ors it into D3D__DirtyFlags (0x13A428) (= 5849)
+TextureState_Stage    = 32      # D3DDevice_SetTextureStageStateNotInline 0x12B14B: [stage * 32 + type] dwords (= 5849)
+Stream_Size           = 12      # D3DDevice_SetStreamSource 0x12C61A indexes the stream table (0x13CD60) by n * 12 (= 5849)
+Stream_Stride         = 0x0     # D3DDevice_SetStreamSource 0x12C662 stores Stride (= 5849)
+Stream_Buffer         = 0x8     # D3DDevice_SetStreamSource 0x12C668 stores the vertex buffer (= 5849)
+PixelShader_Definition = 0x8  # D3DDevice_CreatePixelShader 0x130444 stores the definition pointer (= 5849)
+# DSOUND
+CDirectSoundStream_Vtable  = 0x0  # = 5849; this title creates no DirectSound streams (no stream functions are linked)
+CDirectSoundStream_Vtable2 = 0x4  # = 5849; as above
+EffectsImage_Skip0    = 0x804   # 0x140AD5 adds this dword count (= 5849)
+EffectsImage_Skip1    = 0x80C   # 0x140ACF loads this dword count (= 5849)
+EffectsImage_Desc     = 0x818   # 0x140ADE: descriptor at image + 0x818 + (Skip0 + Skip1) * 4 (= 5849)
+# XAPI XPP device type record
+XPP_Current           = 0x0     # XGetDevices 0x148AC6 returns it (= 5849)
+XPP_Changed           = 0x4     # XGetDevices 0x148AC8 clears it, XGetDeviceChanges 0x148AE6 tests it (= 5849)
+XPP_Previous          = 0x8     # XGetDevices 0x148ACE copies Current into it (= 5849)
+
+# Render-state numbering: all 23 render states XbSymbolDatabase located (D3D_RenderState 0x13A630) have the same
+# index as the runtime's enum (deferred from 92, complex from 136).
