+bool WriteTextureTga(uint32_t header, const char* path) {
+    std::shared_ptr<Image> img = FindImage(header);
+    if (!img || img->texels[0].empty()) return false;
+    FILE* f = std::fopen(path, "wb");
+    if (!f) return false;
+    uint8_t head[18] = {0, 0, 2};
