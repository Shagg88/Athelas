+CDevice_Push          = 0x0     # D3DDevice_SetTexture 0x12D682 reads it, compares with +4, calls MakeSpace 0x130210 (= 5849)
+CDevice_PushThreshold = 0x4     # D3DDevice_SetTexture 0x12D685 compares the push pointer with it (= 5849)
+CDevice_BaseVertex    = 0x1C    # D3DDevice_SetIndices 0x12D8C9 stores BaseVertexIndex (= 5849)
+CDevice_IndexBuffer   = 0x79C   # D3DDevice_SetIndices 0x12D89A reads the old one, 0x12D8C2 stores the new one (5849: 0x7A0)
+CDevice_ZScale        = 0x944   # D3DDevice_GetViewportOffsetAndScale 0x12A814 scales the Z range by it (5849: 0x948)
+CDevice_SuperSampleX  = 0x958   # D3DDevice_GetViewportOffsetAndScale 0x12A76E scales viewport X by it (5849: 0x95C)
+CDevice_SuperSampleY  = 0x95C   # D3DDevice_GetViewportOffsetAndScale 0x12A790 scales viewport Y by it (5849: 0x960)
+CDevice_Transforms    = 0xC50   # D3DDevice_SetTransform 0x12CC76 copies 16 dwords to +0xC50 + type * 64 (5849: 0xC60)
+CDevice_Textures      = 0xF78   # D3DDevice_SetTexture 0x12D640 reads, 0x12D679 stores [stage] (5849: 0xF88)
+CDevice_Palettes      = 0xF88   # Textures + 0x10 as in 5849 and 4928 (the game sets palettes through D3DDevice_SetPalette 0x12D7E0)
+CDevice_RenderTarget  = 0x19F4  # D3DDevice_SetViewport 0x12D417 reads it and compares it with the back buffer (5849: 0x1A04)
+CDevice_Depth         = 0x19F8  # D3DDevice_GetDepthStencilSurface2 0x12D3E6 returns it (5849: 0x1A08)
+CDevice_BackBuffer    = 0x1A04  # D3DDevice_GetBackBuffer2 0x12D3C0 returns it for index 0 (5849: 0x1A14)
+CDevice_FrontBuffer   = 0x1A08  # D3DDevice_GetBackBuffer2 0x12D3A5 returns it for index -1 (5849: 0x1A18)
+CDevice_SwapCount     = 0x2468  # D3DDevice_Swap 0x12F730 increments it, 0x12F7AB reads it (5849: 0x2478)
+CDevice_Size          = 0x2490  # Direct3D_CreateDevice 0x12F91B clears 0x924 dwords of the device on failure (5849: 0x24A0)
+CDevice_Flags             = 0x8    # Direct3D_CreateDevice 0x12F8DE ors BehaviorFlags into it and stores it at 0x13A8D8 = device + 8 (= 5849)
+CDevice_Time              = 0x2C   # D3D_KickOffAndWaitForIdle 0x130275 reads it, D3D_SetFence 0x12FEC4 (= 5849)
+CDevice_PixelShader       = 0x780  # D3DDevice_SetPixelShader 0x1304E8 stores the handle (5849: 0x784)
+CDevice_VertexShader      = 0x790  # D3DDevice_SetVertexShader 0x12CA71 reads the current shader (5849: 0x794)
