+    for (const Vec& c : img->texels[0]) {
+        uint8_t px[4] = {uint8_t(Sat(c[2]) * 255), uint8_t(Sat(c[1]) * 255), uint8_t(Sat(c[0]) * 255), uint8_t(Sat(c[3]) * 255)};
