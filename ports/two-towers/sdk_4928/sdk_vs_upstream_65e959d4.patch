+        return;
+    }
+    float k = (mag - dz) / (1 - dz) / mag;  // corners past the circle stay at the corners
+    x = std::clamp(int(std::lround(fx * k * 32767)), -32768, 32767);
+    y = std::clamp(int(std::lround(fy * k * 32767)), -32768, 32767);
